# Washu Agent lab configuration (copy to washu_agent/.env or set in shell)
WASHU_CONSOLE_URL=http://127.0.0.1:8000
WASHU_INGEST_TOKEN=
WASHU_AGENT_ID=washu-agent
WASHU_VM_NAME=Washu-DC
WASHU_HOSTNAME=
WASHU_HEARTBEAT_INTERVAL=30
WASHU_POLL_INTERVAL=10
# auto | winlog | file | demo
WASHU_EVENT_SOURCE=demo
WASHU_EVENT_LOG_PATH=
# Optional comma-separated honey usernames for demo/filter context
WASHU_HONEY_TARGETS=hw_alex.hale
WASHU_DRY_RUN=false
