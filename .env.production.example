# ActiveDecoy production environment — copy to .env before deploy
# Use: docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d

APP_ENV=production
APP_DEBUG=false
ENFORCE_SECURE_DEFAULTS=true

# Strong secrets (required)
SESSION_SECRET=replace-with-64-char-random-secret-value-minimum-thirty-two
ADMIN_USERNAME=console-breakglass
ADMIN_PASSWORD=replace-with-strong-breakglass-password
AGENT_INGEST_TOKEN=replace-with-random-ingest-token-32chars

# TLS / proxy
CONSOLE_DOMAIN=activedecoy.lab.local
CONSOLE_HTTP_PORT=80
CONSOLE_HTTPS_PORT=443
TRUSTED_PROXY_HOSTS=*
SESSION_HTTPS_ONLY=true
SESSION_SAME_SITE=strict
SESSION_MAX_AGE=28800
CORS_ORIGINS=https://activedecoy.lab.local

# Console auth: ldap (directory operators), env (break-glass), or ldap,env
CONSOLE_AUTH_MODE=ldap,env
CONSOLE_LDAP_DOMAIN=lab.local

# Neo4j (required in production)
NEO4J_PASSWORD=replace-with-strong-neo4j-password

# Directory + honey OU (required if provisioning)
LDAP_HOST=dc01.lab.local
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_BASE_DN=DC=lab,DC=local
AD_PROVISION_ENABLED=true
AD_HONEY_OU=OU=Honey,OU=Lab,DC=lab,DC=local
AD_HARDEN_ON_PROVISION=true
AD_HONEY_WORKSTATIONS_LOCK=NONEXISTENT-AD-LOCK

# Agent
AGENT_STALE_SECONDS=90
HYPERVISOR_VM_NAME=Washu-DC
