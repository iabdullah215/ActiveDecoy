# ActiveDecoy — copy to .env and customize (keep .env out of git)

# development | production (production enforces secrets, TLS sessions, LDAP login)
APP_ENV=development

SESSION_SECRET=change-me-in-production

# Console administrator (required)
ADMIN_USERNAME=HwatSauce
ADMIN_PASSWORD=Active-Decoy!2026
# Break-glass recovery email (enables Forgot password when env auth is on)
ADMIN_EMAIL=

# SMTP for password reset emails (optional in dev if SMTP_DEV_LOG=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_DEV_LOG=true
PASSWORD_RESET_TTL_SECONDS=3600
# Public console URL for links in email (e.g. https://activedecoy.lab.local)
CONSOLE_PUBLIC_URL=

# When true, refuse to start if default admin/session secrets remain.
ENFORCE_SECURE_DEFAULTS=false

# Production session / proxy (see docs/PRODUCTION.md)
# SESSION_HTTPS_ONLY=true
# SESSION_SAME_SITE=strict
# SESSION_MAX_AGE=28800
# TRUSTED_PROXY_HOSTS=*
# CONSOLE_AUTH_MODE=ldap,env
# CONSOLE_LDAP_DOMAIN=lab.local

APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Login brute-force protection
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# For local Python runs against Docker Neo4j, use localhost.
# docker compose sets NEO4J_URI=bolt://neo4j:7687 inside the app container.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ActiveDecoyNeo4j!
NEO4J_DATABASE=neo4j

NEODASH_URL=https://neodash.graphapp.io

LDAP_HOST=dc01.lab.local
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_BIND_DN=
LDAP_PASSWORD=
LDAP_BASE_DN=

HYPERVISOR_TYPE=vmware
HYPERVISOR_ENDPOINT=
HYPERVISOR_USERNAME=
HYPERVISOR_PASSWORD=
HYPERVISOR_VM_NAME=Washu-DC
HYPERVISOR_WRAPPER_COMMAND=

CONNECTION_RETRIES=3
CONNECTION_RETRY_DELAY=0.5

# Directory enumeration limits (Chunk 3)
LDAP_PAGE_SIZE=200
LDAP_MAX_OBJECTS=500

# Chunk 4 — AD honey provisioning (authorized labs only)
# Leave AD_PROVISION_ENABLED=false until a dedicated honey OU exists.
AD_PROVISION_ENABLED=false
AD_HONEY_OU=
# Example: OU=Honey,OU=Lab,DC=lab,DC=local
AD_HONEY_NAME_PREFIX=hw_
AD_REQUIRE_NAME_PREFIX=true
# Optional comma-separated DNS domains for multi-domain labs
AD_MONITORED_DOMAINS=
# Production: lock honey users to a non-existent workstation on provision
AD_HARDEN_ON_PROVISION=false
AD_HONEY_WORKSTATIONS_LOCK=NONEXISTENT-AD-LOCK

# Chunk 6 — agent / SIEM telemetry ingest
# Leave empty to disable POST /api/monitoring/ingest and /api/agents/heartbeat
AGENT_INGEST_TOKEN=

# Authorized lab stack (docker compose -f docker-compose.yml -f docker-compose.lab.yml)
# LDAP_LAB_MODE=true
# LAB_LDAP_ADMIN_PASSWORD=ActiveDecoyLab!2026
# LDAP_BIND_DN=cn=admin,dc=lab,dc=local
# LDAP_PASSWORD=ActiveDecoyLab!2026
# LDAP_BASE_DN=dc=lab,dc=local
# HYPERVISOR_TYPE=utm
# HYPERVISOR_WRAPPER_COMMAND=/app/scripts/lab_hypervisor_health.sh
# Mark Washu Agent stale when last heartbeat older than this many seconds
AGENT_STALE_SECONDS=90

# Chunk 7 — Washu Agent (see washu_agent/.env.example)
# WASHU_CONSOLE_URL=http://127.0.0.1:8000
# WASHU_INGEST_TOKEN=  # same value as AGENT_INGEST_TOKEN
# WASHU_AGENT_ID=washu-agent
# WASHU_VM_NAME=Washu-DC
# WASHU_EVENT_SOURCE=demo

